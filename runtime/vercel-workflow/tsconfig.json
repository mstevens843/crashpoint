{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "plugins": [{ "name": "workflow" }]
  },
  "include": ["src/**/*.ts", "nitro.config.ts"]
}
